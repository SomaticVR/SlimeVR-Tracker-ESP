# Project settings
PROJECT_NAME           = "SlimeVR Tracker ESP"
PROJECT_BRIEF          = "Firmware for ESP8266 / ESP32 microcontrollers and different IMU sensors to use them as a vive-like trackers in VR."
PROJECT_NUMBER         = "1.0.0"

# Output settings
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES

# Input settings
INPUT                  = src include
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.hpp *.h
EXCLUDE_PATTERNS       = */test/* */build/*
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

# Documentation content and style
EXTRACT_ALL            = YES
WARN_NO_PARAMDOC       = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Graphviz integration (if installed)
HAVE_DOT               = NO
DOT_GRAPH_MAX_NODES    = 100
